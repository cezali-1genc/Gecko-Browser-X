{
  "manifest_version": 2,
  "name": "ModLU Night Reader Style",
  "version": "1.0.0",
  "description": "Improves dark contrast on bright pages when enabled.",
  "applications": {
    "gecko": {
      "id": "modlu-dark@modlu1apk.browserx"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
