{
  "manifest_version": 2,
  "name": "ModLU Cosmetic Shield",
  "version": "1.0.0",
  "description": "Reduces intrusive cookie banners and ad placeholders via GeckoView WebExtension.",
  "applications": {
    "gecko": {
      "id": "modlu-shield@modlu1apk.browserx"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
